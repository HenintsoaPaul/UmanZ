<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="10-mfa-updates" author="antigravity">
        <addColumn tableName="talent">
            <column name="mfa_enabled" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="mfa_secret" type="VARCHAR(255)"/>
            <column name="mfa_scratch_codes" type="TEXT"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
